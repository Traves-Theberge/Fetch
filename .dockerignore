# Dependencies (reinstalled inside Docker)
**/node_modules

# Build outputs (rebuilt inside Docker)
**/dist

# Turborepo cache
.turbo

# Git history
.git
.gitignore

# Runtime data (not part of build)
data/
workspace/

# Go manager (built separately in CI, not needed in bridge image)
apps/manager/fetch-manager*

# Kennel (separate build context)
kennel/

# IDE / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Secrets (injected at runtime via env_file)
.env
.env.*
!.env.example

# Test files (not needed in production image)
**/*.test.ts
**/tests
**/coverage

# Markdown docs at root (keep docs/ directory for container serving)
*.md

# Build artifacts
**/.nyc_output
