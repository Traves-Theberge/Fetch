# Fetch Systemd Service
#
# Install: sudo cp fetch.service /etc/systemd/system/
#          sudo systemctl enable fetch
#          sudo systemctl start fetch
#
# Replace __FETCH_DIR__ and __FETCH_USER__ before installing.

[Unit]
Description=Fetch - Unleash Multi-agent Orchestration
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__FETCH_DIR__
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
User=__FETCH_USER__
Group=docker

[Install]
WantedBy=multi-user.target
