{
  "name": "fetch-bridge",
  "version": "4.3.0",
  "description": "Fetch - WhatsApp AI Assistant",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "lint": "eslint src/**/*.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "dockerode": "^4.0.9",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "jsdom": "^28.0.0",
    "nanoid": "^5.1.6",
    "openai": "^6.18.0",
    "strip-ansi": "^7.1.2",
    "turndown": "^7.2.2",
    "whatsapp-web.js": "^1.34.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/dockerode": "^4.0.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.2.1",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
